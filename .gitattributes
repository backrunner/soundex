# Git LFS for model files
*.onnx filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
# Tiny deterministic test graphs stay in Git so CI does not require LFS checkout.
tests/fixtures/*.onnx -filter -diff -merge -text

# Consistent line endings
*.rs text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.wav binary
*.mp3 binary
*.flac binary
*.png binary
*.jpg binary
